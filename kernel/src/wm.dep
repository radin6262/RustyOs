
# this method is no longer used and is deprecated, but we keep it for reference

#![no_std]

mod window;
mod compositor;

extern crate alloc;
use alloc::vec::Vec;
use alloc::collections::BTreeMap;
use spin::Mutex;

// ============================================================
// Window Manager State
// ============================================================

pub struct Window {
    pub id: u64,
    pub x: i32,
    pub y: i32,
    pub width: usize,
    pub height: usize,
    pub pixels: Vec<u32>, // 32-bit ARGB/XRGB pixels
    pub z_index: usize,
}

pub struct Compositor {
    pub windows: BTreeMap<u64, Window>,
    pub screen_width: usize,
    pub screen_height: usize,
    pub hardware_framebuffer: &'static mut [u32],
    pub backbuffer: Vec<u32>, // Double buffering to prevent tearing
    next_window_id: u64,
    next_z_index: usize,
}

pub static WM: Mutex<Option<Compositor>> = Mutex::new(None);

impl Compositor {
    pub fn init(width: usize, height: usize, fb_ptr: *mut u32) {
        let size = width * height;
        let hw_fb = unsafe { core::slice::from_raw_parts_mut(fb_ptr, size) };
        let mut backbuffer = Vec::with_capacity(size);
        backbuffer.resize(size, 0xFF000000); // Fill with black

        *WM.lock() = Some(Compositor {
            windows: BTreeMap::new(),
            screen_width: width,
            screen_height: height,
            hardware_framebuffer: hw_fb,
            backbuffer,
            next_window_id: 1,
            next_z_index: 1,
        });
    }

    pub fn create_window(&mut self, x: i32, y: i32, width: usize, height: usize) -> u64 {
        let id = self.next_window_id;
        self.next_window_id += 1;

        let mut pixels = Vec::with_capacity(width * height);
        pixels.resize(width * height, 0xFF222222); // Default dark gray background

        let z = self.next_z_index;
        self.next_z_index += 1;

        self.windows.insert(id, Window {
            id, x, y, width, height, pixels, z_index: z,
        });

        id
    }

    pub fn update_window_pixels(&mut self, id: u64, user_buffer: &[u32]) {
        if let Some(win) = self.windows.get_mut(&id) {
            let len = core::cmp::min(win.pixels.len(), user_buffer.len());
            win.pixels[..len].copy_from_slice(&user_buffer[..len]);
        }
    }

    pub fn draw(&mut self) {
        // 1. Clear backbuffer (Draw desktop background)
        self.backbuffer.fill(0xFF115588); // OS Background color (e.g., a nice blue)

        // 2. Sort windows by Z-Index (Painter's algorithm)
        let mut sorted_windows: Vec<&Window> = self.windows.values().collect();
        sorted_windows.sort_by_key(|w| w.z_index);

        // 3. Composite each window onto the backbuffer
        for win in sorted_windows {
            // Calculate safe clipping bounds so off-screen windows don't crash us
            let start_x = core::cmp::max(0, win.x) as usize;
            let start_y = core::cmp::max(0, win.y) as usize;

            let end_x = core::cmp::min(self.screen_width as i32, win.x + win.width as i32) as usize;
            let end_y = core::cmp::min(self.screen_height as i32, win.y + win.height as i32) as usize;

            for py in start_y..end_y {
                for px in start_x..end_x {
                    // Calculate index in the window's local buffer
                    let win_x = px as i32 - win.x;
                    let win_y = py as i32 - win.y;
                    let win_idx = (win_y as usize) * win.width + (win_x as usize);

                    // Calculate index in the screen buffer
                    let screen_idx = py * self.screen_width + px;

                    let pixel = win.pixels[win_idx];

                    // Basic Alpha Blending (if alpha > 0, draw it)
                    // (pixel >> 24) gets the top 8 bits (alpha channel)
                    if (pixel >> 24) > 128 {
                        self.backbuffer[screen_idx] = pixel;
                    }
                }
            }
        }

        // 4. Blit backbuffer to hardware framebuffer (Vsync should ideally happen here)
        self.hardware_framebuffer.copy_from_slice(&self.backbuffer);
    }
}

// Add this to the bottom of wm.rs:
pub fn init(width: usize, height: usize, fb_ptr: *mut u32) {
    Compositor::init(width, height, fb_ptr);
}